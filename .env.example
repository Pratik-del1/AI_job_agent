# Copy to .env and fill in. .env is gitignored.

# LLM provider: google or openai
JOBAGENT_LLM_PROVIDER=google
JOBAGENT_LLM_MODEL=gemini-3.5-flash
GOOGLE_API_KEY=

# To use OpenAI instead: pip install langchain-openai, then
# JOBAGENT_LLM_PROVIDER=openai
# JOBAGENT_LLM_MODEL=<an OpenAI model name>
# OPENAI_API_KEY=

# Resume to extract. Relative paths are resolved against the project root.
JOBAGENT_RESUME_FILE=data/Pratik-Resume-2.pdf

# Job matcher: legacy (original scorer, the default) or hybrid
# (explainable scorer). Uncomment to use the hybrid matcher.
# JOBAGENT_MATCHER=hybrid

# Hybrid matcher weights. A component that cannot be scored for a job is
# left out and the others are renormalised.
# JOBAGENT_MATCH_WEIGHT_SKILL=0.30
# JOBAGENT_MATCH_WEIGHT_ROLE=0.30
# JOBAGENT_MATCH_WEIGHT_EXPERIENCE=0.20
# JOBAGENT_MATCH_WEIGHT_SEMANTIC=0.10
# JOBAGENT_MATCH_WEIGHT_PREFERENCE=0.10
# JOBAGENT_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Label caps: set the gap to null to switch the experience cap off.
# JOBAGENT_MATCH_EXPERIENCE_CAP_GAP_YEARS=4
# JOBAGENT_MATCH_EXPERIENCE_CAP_LABEL=CONSIDER
# See jobagent/config.py for the full list of matching settings.

# Optional overrides
# JOBAGENT_LLM_TIMEOUT_SECONDS=60
# JOBAGENT_LLM_MAX_RETRIES=2
# JOBAGENT_LLM_RETRY_BACKOFF_SECONDS=2
